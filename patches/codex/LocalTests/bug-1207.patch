 public class ManualEntryDialog {
+    private static boolean isPositiveInteger(EditText input) {
+        String value = input.getText().toString().trim();
+
+        if (TextUtils.isEmpty(value)) {
+            return false;
+        }
+
+        try {
+            return Integer.parseInt(value) > 0;
+        } catch (NumberFormatException ignored) {
+            return false;
+        }
+    }
+
+    private static boolean hasValidInput(EditText labelInput, EditText secretInput, EditText periodInput, EditText digitsInput, Spinner typeInput) {
+        if (TextUtils.isEmpty(labelInput.getText()) || TextUtils.isEmpty(secretInput.getText())) {
+            return false;
+        }
+
+        Entry.OTPType type = (Entry.OTPType) typeInput.getSelectedItem();
+        if (type == Entry.OTPType.TOTP) {
+            return isPositiveInteger(periodInput) && isPositiveInteger(digitsInput);
+        }
+
+        return true;
+    }
