+    private String getUniqueEncryptedFilePath(String sourcePath) {
+        final String pdfExtension = mActivity.getString(R.string.pdf_ext);
+        final String encryptedSuffix = mActivity.getString(R.string.encrypted_file);
+
+        String encryptedPath = sourcePath;
+        if (sourcePath.endsWith(pdfExtension)) {
+            encryptedPath = sourcePath.substring(0, sourcePath.length() - pdfExtension.length())
+                    + encryptedSuffix;
+        }
+
+        File encryptedFile = new File(encryptedPath);
+        if (!encryptedFile.exists()) {
+            return encryptedPath;
+        }
+
+        String outputName = encryptedFile.getName();
+        int extensionIndex = outputName.lastIndexOf(pdfExtension);
+        String outputNameWithoutExtension = extensionIndex >= 0
+                ? outputName.substring(0, extensionIndex)
+                : outputName;
+        File parent = encryptedFile.getParentFile();
+
+        int suffixNumber = 2;
+        File candidate;
+        do {
+            String candidateName = outputNameWithoutExtension + suffixNumber + pdfExtension;
+            candidate = parent == null ? new File(candidateName) : new File(parent, candidateName);
+            suffixNumber++;
+        } while (candidate.exists());
+
+        return candidate.getAbsolutePath();
+    }
