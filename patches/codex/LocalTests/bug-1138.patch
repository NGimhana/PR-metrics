+    private boolean hasStoragePermissions() {
+        return ContextCompat.checkSelfPermission(this, Manifest.permission.WRITE_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED
+                && ContextCompat.checkSelfPermission(this, Manifest.permission.READ_EXTERNAL_STORAGE) == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void startStoragePermissionChecks() {
+        hasShownStoragePermissionErrorNotification = false;
+        handler.removeCallbacks(storagePermissionCheckRunnable);
+        handler.post(storagePermissionCheckRunnable);
+    }
+
+    private void stopStoragePermissionChecks() {
+        handler.removeCallbacks(storagePermissionCheckRunnable);
+        hasShownStoragePermissionErrorNotification = false;
+    }
+
+    private final Runnable storagePermissionCheckRunnable = new Runnable() {
+        @Override
+        public void run() {
+            if (!session.isStarted()) {
+                return;
+            }
+
+            if (!hasStoragePermissions()) {
+                if (!hasShownStoragePermissionErrorNotification) {
+                    showFileWriteErrorNotification();
+                    hasShownStoragePermissionErrorNotification = true;
+                }
+            } else {
+                hasShownStoragePermissionErrorNotification = false;
+            }
+
+            handler.postDelayed(this, STORAGE_PERMISSION_CHECK_INTERVAL_MS);
+        }
+    };
+
+    private void showFileWriteErrorNotification() {
+        notificationManager = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
+        if (notificationManager == null) {
+            return;
+        }
+
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+            NotificationChannel errorChannel = new NotificationChannel(
+                    ERROR_NOTIFICATION_CHANNEL_ID,
+                    getString(R.string.error),
+                    NotificationManager.IMPORTANCE_HIGH
+            );
+            errorChannel.enableLights(true);
+            errorChannel.enableVibration(true);
+            notificationManager.createNotificationChannel(errorChannel);
+        }
+
+        Intent contentIntent = new Intent(this, GpsMainActivity.class);
+        PendingIntent contentPendingIntent = PendingIntent.getActivity(this, 0, contentIntent, PendingIntent.FLAG_UPDATE_CURRENT);
+
+        NotificationCompat.Builder builder = new NotificationCompat.Builder(getApplicationContext(), ERROR_NOTIFICATION_CHANNEL_ID)
+                .setSmallIcon(R.drawable.notification)
+                .setContentTitle(getString(R.string.error))
+                .setContentText(getString(R.string.could_not_write_to_file))
+                .setStyle(new NotificationCompat.BigTextStyle().bigText(getString(R.string.could_not_write_to_file)))
+                .setPriority(NotificationCompat.PRIORITY_HIGH)
+                .setAutoCancel(true)
+                .setContentIntent(contentPendingIntent);
+
+        notificationManager.notify(ERROR_NOTIFICATION_ID, builder.build());
+    }
