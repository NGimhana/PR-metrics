+++ b/app/src/main/java/org/shadowice/flocke/andotp/Utilities/PasswordTransformationHelper.java
@@ -0,0 +1,39 @@
+package org.shadowice.flocke.andotp.Utilities;
+
+import android.text.method.PasswordTransformationMethod;
+import android.view.View;
+import android.widget.EditText;
+
+import com.google.android.material.textfield.TextInputLayout;
+
+public final class PasswordTransformationHelper {
+    private PasswordTransformationHelper() {}
+
+    public static void setupPasswordAndConfirmTransformation(final TextInputLayout passwordLayout, final EditText passwordInput, final EditText passwordConfirm) {
+        passwordLayout.setEndIconOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                boolean isObscured = passwordInput.getTransformationMethod() instanceof PasswordTransformationMethod;
+                dispatchPasswordVisibilityChange(passwordInput, isObscured);
+                dispatchPasswordVisibilityChange(passwordConfirm, isObscured);
+                passwordLayout.refreshDrawableState();
+            }
+        });
+
+        passwordInput.setTransformationMethod(PasswordTransformationMethod.getInstance());
+        passwordConfirm.setTransformationMethod(PasswordTransformationMethod.getInstance());
+    }
+
+    private static void dispatchPasswordVisibilityChange(EditText editText, boolean isObscured) {
+        final int selection = editText.getSelectionEnd();
+        if (isObscured) {
+            editText.setTransformationMethod(null);
+        } else {
+            editText.setTransformationMethod(PasswordTransformationMethod.getInstance());
+        }
+
+        if (selection >= 0) {
+            editText.setSelection(selection);
+        }
+    }
+}