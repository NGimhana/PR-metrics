+    /**
+     * Stores the current list position so it can be restored after refreshing the same location.
+     */
+    private void captureScrollPositionForReload() {
+        if (fileListView == null) {
+            clearPendingScrollRestore();
+            return;
+        }
+
+        pendingScrollFirstVisiblePosition = fileListView.getFirstVisiblePosition();
+        View firstChild = fileListView.getChildAt(0);
+        pendingScrollTopOffset = firstChild != null ? firstChild.getTop() : 0;
+        restoreScrollOnNextLoad = true;
+    }
+
+    /**
+     * Restores previously saved list position once a new adapter has been attached.
+     */
+    private void restoreScrollPositionIfNeeded() {
+        if (!restoreScrollOnNextLoad || fileListView == null || arrayAdapter == null) {
+            return;
+        }
+
+        int count = arrayAdapter.getCount();
+        if (count <= 0) {
+            clearPendingScrollRestore();
+            return;
+        }
+
+        int safePosition = Math.max(0, Math.min(pendingScrollFirstVisiblePosition, count - 1));
+        fileListView.post(() -> fileListView.setSelectionFromTop(safePosition, pendingScrollTopOffset));
+        clearPendingScrollRestore();
+    }
+
+    /**
+     * Clears pending list restore state.
+     */
+    private void clearPendingScrollRestore() {
+        restoreScrollOnNextLoad = false;
+        pendingScrollFirstVisiblePosition = 0;
+        pendingScrollTopOffset = 0;
     }
 
