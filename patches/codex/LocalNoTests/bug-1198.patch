+        if (path.endsWith(pdfExtension)) {
+            baseName = path.substring(0, path.length() - pdfExtension.length());
+        }
+
+        String encryptedBaseName = baseName + encryptedSuffix.replace(pdfExtension, "");
+        String candidatePath = encryptedBaseName + pdfExtension;
+        int fileIndex = 1;
+
+        while (new File(candidatePath).exists()) {
+            candidatePath = encryptedBaseName + fileIndex + pdfExtension;
+            fileIndex++;
+        }
+        return candidatePath;
+    }
