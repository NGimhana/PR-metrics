+    static String expandTruncatedLinks(String html) {
+        Document document = Jsoup.parseBodyFragment(html);
+
+        for (Element link : document.select("a[href]")) {
+            String href = link.attr("href").trim();
+            String linkText = link.text().trim();
+
+            if (isTruncatedHrefText(linkText, href)) {
+                link.text(href);
+            }
+        }
+
+        return document.body().html();
+    }
+
+    private static boolean isTruncatedHrefText(String linkText, String href) {
+        if (linkText.endsWith("...")) {
+            String linkPrefix = linkText.substring(0, linkText.length() - 3).trim();
+            return !linkPrefix.isEmpty() && href.startsWith(linkPrefix);
+        } else if (linkText.endsWith("…")) {
+            String linkPrefix = linkText.substring(0, linkText.length() - 1).trim();
+            return !linkPrefix.isEmpty() && href.startsWith(linkPrefix);
+        }
+
+        return false;
+    }
+
