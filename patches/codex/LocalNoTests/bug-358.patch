+    /**
+     * Extracts query parameters from an encoded query string.
+     */
+    private static List<QueryParameter> parseQuery(String encodedQuery) {
+        var parameters = new ArrayList<QueryParameter>();
+        if (encodedQuery == null) return parameters;
+
+        int start = 0;
+        do {
+            int next = encodedQuery.indexOf('&', start);
+            int end = next == -1 ? encodedQuery.length() : next;
+            if (end > start) {
+                int separator = encodedQuery.indexOf('=', start);
+                if (separator == -1 || separator > end) separator = end;
+
+                parameters.add(new QueryParameter(
+                        decodeQueryPart(encodedQuery.substring(start, separator)),
+                        separator == end ? "" : decodeQueryPart(encodedQuery.substring(separator + 1, end))
+                ));
+            }
+            start = end + 1;
+        } while (start < encodedQuery.length());
+
+        return parameters;
+    }
+
+    /**
+     * Decodes a query name/value as UTF-8, including values that contain encoded percent signs.
+     */
+    private static String decodeQueryPart(String encodedPart) {
+        var decoded = Uri.decode(encodedPart.replace("+", "%20"));
+        for (int i = 0; i < 5 && decoded.contains("%"); i++) {
+            var next = Uri.decode(decoded);
+            if (next.equals(decoded)) break;
+            decoded = next;
+        }
+        return decoded;
+    }
+
+    private static class QueryParameter {
+        private final String name;
+        private final String value;
+
+        private QueryParameter(String name, String value) {
+            this.name = name;
+            this.value = value;
+        }
+    }
+
