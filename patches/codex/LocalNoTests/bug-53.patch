+    private int getInitialTypeSelection(String extension, String[] typeSpinnerToExtension) {
+        if (typeSpinnerToExtension == null || typeSpinnerToExtension.length == 0) {
+            return 0;
+        }
+
+        int noneTypeIndex = 0;
+        for (int i = 0; i < typeSpinnerToExtension.length; i++) {
+            if (TextUtils.isEmpty(typeSpinnerToExtension[i])) {
+                noneTypeIndex = i;
+                break;
+            }
+        }
+
+        if (extension == null) {
+            return noneTypeIndex;
+        }
+
+        String normalizedExtension = extension.trim();
+        if (normalizedExtension.endsWith(JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION)) {
+            normalizedExtension = normalizedExtension.substring(0, normalizedExtension.length() - JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION.length());
+        }
+        for (int i = 0; i < typeSpinnerToExtension.length; i++) {
+            if (normalizedExtension.equalsIgnoreCase(typeSpinnerToExtension[i])) {
+                return i;
+            }
+        }
+        return noneTypeIndex;
+    }
