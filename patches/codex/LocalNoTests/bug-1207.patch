+            if (showErrors) {
+                input.setError(input.getContext().getString(R.string.error_value_required));
+            }
+
+            return null;
+        }
+
+        try {
+            int parsedValue = Integer.parseInt(value);
+
+            if (parsedValue <= 0) {
+                if (showErrors) {
+                    input.setError(input.getContext().getString(R.string.error_value_must_be_positive));
+                }
+
+                return null;
+            }
+
+            input.setError(null);
+            return parsedValue;
+        } catch (NumberFormatException e) {
+            if (showErrors) {
+                input.setError(input.getContext().getString(R.string.error_value_must_be_positive));
+            }
+
+            return null;
+        }
+    }
