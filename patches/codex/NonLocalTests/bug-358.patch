+    private List<QueryParameter> parseQueryParameters(String query) {
+        var parameters = new ArrayList<QueryParameter>();
+        if (query == null || query.isEmpty()) return parameters;
+
+        var rawParameters = query.split("&", -1);
+        for (var rawParameter : rawParameters) {
+            var separator = rawParameter.indexOf('=');
+            var rawName = separator >= 0 ? rawParameter.substring(0, separator) : rawParameter;
+            var rawValue = separator >= 0 ? rawParameter.substring(separator + 1) : "";
+            parameters.add(new QueryParameter(Uri.decode(rawName), Uri.decode(rawValue)));
+        }
+
+        return parameters;
+    }
+
+    private static class QueryParameter {
+        private final String name;
+        private final String value;
+
+        private QueryParameter(String name, String value) {
+            this.name = name;
+            this.value = value;
+        }
+    }
