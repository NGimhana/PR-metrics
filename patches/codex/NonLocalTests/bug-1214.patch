+        private void setPasswordHidden(EditText input) {
+            int cursorPos = input.getSelectionEnd();
+            input.setTransformationMethod(new PasswordTransformationMethod());
+            if (cursorPos >= 0) {
+                input.setSelection(Math.min(cursorPos, input.length()));
+            }
+        }
+
+        private void setPasswordVisible(EditText input) {
+            int cursorPos = input.getSelectionEnd();
+            input.setTransformationMethod(null);
+            if (cursorPos >= 0) {
+                input.setSelection(Math.min(cursorPos, input.length()));
+            }
+        }
+
+        private void syncConfirmVisibilityWithPrimary() {
+            if (passwordInput.getTransformationMethod() == null) {
+                setPasswordVisible(passwordConfirm);
+            } else {
+                setPasswordHidden(passwordConfirm);
+            }
+        }
+
+        private void togglePasswordVisibility() {
+            if (passwordInput.getTransformationMethod() == null) {
+                setPasswordHidden(passwordInput);
+                setPasswordHidden(passwordConfirm);
+            } else {
+                setPasswordVisible(passwordInput);
+                setPasswordVisible(passwordConfirm);
+            }
+        }
