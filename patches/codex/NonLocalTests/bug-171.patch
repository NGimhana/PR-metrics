+
 public class DialogUtils {
+    private static final Pattern ANCHOR_PATTERN = Pattern.compile("(?is)<a\\b([^>]*)>(.*?)</a>");
+    private static final Pattern HREF_PATTERN = Pattern.compile("(?is)\\bhref\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))");
+
+    private static String expandTruncatedAnchorText(String text) {
+        Matcher anchorMatcher = ANCHOR_PATTERN.matcher(text);
+        StringBuffer result = new StringBuffer();
+
+        while (anchorMatcher.find()) {
+            String attrs = anchorMatcher.group(1);
+            String innerHtml = anchorMatcher.group(2);
+            String innerText = innerHtml.replaceAll("(?is)<[^>]+>", "").trim();
+            String href = null;
+
+            Matcher hrefMatcher = HREF_PATTERN.matcher(attrs);
+            if (hrefMatcher.find()) {
+                href = hrefMatcher.group(1);
+                if (href == null) href = hrefMatcher.group(2);
+                if (href == null) href = hrefMatcher.group(3);
+            }
+
+            if (!TextUtils.isEmpty(href) && innerText.startsWith("http")
+                    && (innerText.endsWith("...") || innerText.endsWith("\u2026"))) {
+                String replacement = "<a" + attrs + ">" + TextUtils.htmlEncode(href) + "</a>";
+                anchorMatcher.appendReplacement(result, Matcher.quoteReplacement(replacement));
+            } else {
+                anchorMatcher.appendReplacement(result, Matcher.quoteReplacement(anchorMatcher.group(0)));
+            }
+        }
+
+        anchorMatcher.appendTail(result);
+        return result.toString();
+    }
 
