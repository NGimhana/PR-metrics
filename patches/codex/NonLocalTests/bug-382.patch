+    private static List<QueryParameter> parseEncodedQuery(String encodedQuery) {
+        var parameters = new ArrayList<QueryParameter>();
+        if (encodedQuery == null || encodedQuery.isEmpty()) return parameters;
+
+        for (var encodedPart : encodedQuery.split("&", -1)) {
+            var separator = encodedPart.indexOf('=');
+            if (separator < 0) {
+                parameters.add(new QueryParameter(encodedPart, ""));
+            } else {
+                parameters.add(new QueryParameter(
+                        encodedPart.substring(0, separator),
+                        encodedPart.substring(separator + 1)
+                ));
+            }
+        }
+        return parameters;
+    }
+
+    private static String buildEncodedQueryWithoutIndex(List<QueryParameter> parameters, int removeI) {
+        var builder = new StringBuilder();
+        for (var i = 0; i < parameters.size(); i++) {
+            if (i == removeI) continue;
+            if (builder.length() > 0) builder.append('&');
+            builder.append(parameters.get(i).encodedName);
+            builder.append('=');
+            builder.append(parameters.get(i).encodedValue);
+        }
+        return builder.length() == 0 ? null : builder.toString();
+    }
