+    private int getTypeSpinnerPositionForExtension(final String extension, final String[] spinnerExtensions) {
+        if (spinnerExtensions == null || spinnerExtensions.length == 0) {
+            return 0;
+        }
+        String normalizedExtension = extension == null ? "" : extension;
+        if (normalizedExtension.endsWith(JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION)) {
+            normalizedExtension = normalizedExtension.substring(
+                    0,
+                    normalizedExtension.length() - JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION.length()
+            );
+        }
+        for (int i = 0; i < spinnerExtensions.length; i++) {
+            if (TextUtils.equals(spinnerExtensions[i], normalizedExtension)) {
+                return i;
+            }
+        }
+        return 0;
+    }
