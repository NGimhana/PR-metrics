+    private String getUniqueEncryptedOutputFile(String path) {
+        File sourceFile = new File(path);
+        File parentFolder = sourceFile.getParentFile();
+        String sourceName = sourceFile.getName();
+        String extension = mActivity.getString(R.string.pdf_ext);
+        String encryptedSuffix = mActivity.getString(R.string.encrypted_file);
+        String encryptedBaseSuffix = encryptedSuffix.replace(extension, "");
+        String fileNameWithoutExtension = sourceName.endsWith(extension)
+                ? sourceName.substring(0, sourceName.length() - extension.length())
+                : sourceName;
+
+        File encryptedFile = new File(parentFolder, fileNameWithoutExtension + encryptedSuffix);
+        if (!encryptedFile.exists()) {
+            return encryptedFile.getAbsolutePath();
+        }
+
+        int index = 2;
+        while (encryptedFile.exists()) {
+            encryptedFile = new File(parentFolder, fileNameWithoutExtension
+                    + encryptedBaseSuffix + index + extension);
+            index++;
+        }
+        return encryptedFile.getAbsolutePath();
+    }
