+    private String getUniqueEncryptedFilePath(String sourceFilePath) {
+        final String pdfExtension = mActivity.getString(R.string.pdf_ext);
+        final String encryptedSuffix = mActivity.getString(R.string.encrypted_file).replace(pdfExtension, "");
+        File sourceFile = new File(sourceFilePath);
+        String sourceName = sourceFile.getName();
+        String sourceBaseName = sourceName.endsWith(pdfExtension)
+                ? sourceName.substring(0, sourceName.length() - pdfExtension.length())
+                : sourceName;
+
+        File parentDir = sourceFile.getParentFile();
+        if (parentDir == null) {
+            parentDir = new File(".");
+        }
+        String candidateBaseName = sourceBaseName + encryptedSuffix;
+        File candidateFile = new File(parentDir, candidateBaseName + pdfExtension);
+
+        int counter = 1;
+        while (candidateFile.exists()) {
+            candidateFile = new File(parentDir, candidateBaseName + counter + pdfExtension);
+            counter++;
+        }
+
+        return candidateFile.getAbsolutePath();
+    }
