+    private static List<QueryParameter> getQueryParameters(Uri uri) {
+        var query = uri.getEncodedQuery();
+        var parameters = new ArrayList<QueryParameter>();
+        if (query == null || query.isEmpty()) return parameters;
+
+        for (var part : query.split("&", -1)) {
+            var split = part.indexOf('=');
+            var name = split == -1 ? part : part.substring(0, split);
+            var value = split == -1 ? "" : part.substring(split + 1);
+            parameters.add(new QueryParameter(decodeQueryPart(name), decodeQueryPart(value)));
+        }
+        return parameters;
+    }
+
+    private static String decodeQueryPart(String part) {
+        // Query strings commonly use '+' for spaces, but a '+' produced by
+        // decoding "%2B" must stay as '+'. Apply the form rule only once.
+        var decoded = safeDecode(part.replace("+", " "));
+        while (true) {
+            var next = safeDecode(decoded);
+            if (next.equals(decoded)) return decoded;
+            decoded = next;
+        }
+    }
+
+    private static String safeDecode(String part) {
+        try {
+            return Uri.decode(part);
+        } catch (Exception e) {
+            return part;
+        }
+    }
+
+    private static class QueryParameter {
+        final String name;
+        final String value;
+
+        QueryParameter(String name, String value) {
+            this.name = name;
+            this.value = value;
+        }
+    }
