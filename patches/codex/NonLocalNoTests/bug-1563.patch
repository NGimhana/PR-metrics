+    private void cacheListScrollPositionForReload() {
+        if (fileListView == null || fileListView.getAdapter() == null) {
+            clearPendingListScrollRestore();
+            return;
+        }
+        int firstVisiblePosition = fileListView.getFirstVisiblePosition();
+        if (firstVisiblePosition < 0) {
+            clearPendingListScrollRestore();
+            return;
+        }
+        View firstChild = fileListView.getChildAt(0);
+        pendingListScrollPosition = firstVisiblePosition;
+        pendingListScrollOffset = firstChild == null ? 0 : firstChild.getTop() - fileListView.getPaddingTop();
+        restoreListScrollOnNextLoad = true;
+    }
+
+    private void restoreListScrollPositionIfNeeded() {
+        if (!restoreListScrollOnNextLoad || fileListView == null || fileListView.getAdapter() == null) {
+            return;
+        }
+        int itemCount = fileListView.getAdapter().getCount();
+        if (itemCount > 0) {
+            int targetPos = Math.min(pendingListScrollPosition, itemCount - 1);
+            if (targetPos >= 0) {
+                fileListView.setSelectionFromTop(targetPos, pendingListScrollOffset);
+            }
+        }
+        clearPendingListScrollRestore();
+    }
+
+    private void clearPendingListScrollRestore() {
+        pendingListScrollPosition = INVALID_SCROLL_POSITION;
+        pendingListScrollOffset = 0;
+        restoreListScrollOnNextLoad = false;
     }
 
