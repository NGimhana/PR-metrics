+    private int getTypeSpinnerPositionFromExtension(String extension, String[] typeSpinnerToExtension) {
+        String normalizedExtension = extension == null ? "" : extension.trim();
+        if (normalizedExtension.endsWith(JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION)) {
+            normalizedExtension = normalizedExtension.substring(0, normalizedExtension.length() - JavaPasswordbasedCryption.DEFAULT_ENCRYPTION_EXTENSION.length());
+        }
+
+        int fallbackPosition = 0;
+        int longestSuffixMatchLength = -1;
+        for (int pos = 0; pos < typeSpinnerToExtension.length; pos++) {
+            String mappedExtension = typeSpinnerToExtension[pos];
+            if (TextUtils.isEmpty(mappedExtension)) {
+                fallbackPosition = pos;
+                continue;
+            }
+            if (mappedExtension.equals(normalizedExtension)) {
+                return pos;
+            }
+            if (normalizedExtension.endsWith(mappedExtension) && mappedExtension.length() > longestSuffixMatchLength) {
+                fallbackPosition = pos;
+                longestSuffixMatchLength = mappedExtension.length();
+            }
+        }
+        return fallbackPosition;
+    }
+
