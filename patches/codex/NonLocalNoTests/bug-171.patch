+    static String expandTruncatedLinksForSelection(String html) {
+        if (html == null) {
+            return "";
+        }
+
+        Matcher matcher = ANCHOR_WITH_HREF_PATTERN.matcher(html);
+        StringBuffer expandedHtml = new StringBuffer();
+
+        while (matcher.find()) {
+            String linkText = Html.fromHtml(matcher.group(4)).toString().trim();
+
+            if (linkText.endsWith("...") || linkText.endsWith("…")) {
+                String href = Html.fromHtml(matcher.group(3)).toString();
+                String replacement = "<a" + matcher.group(1) + ">"
+                        + TextUtils.htmlEncode(href)
+                        + "</a>";
+                matcher.appendReplacement(expandedHtml, Matcher.quoteReplacement(replacement));
+            } else {
+                matcher.appendReplacement(expandedHtml, Matcher.quoteReplacement(matcher.group(0)));
+            }
+        }
+
+        matcher.appendTail(expandedHtml);
+        return expandedHtml.toString();
+    }
+
