+    /**
+     * Replaces the display text of URLSpans with the full URL from the href attribute.
+     * This ensures that truncated link text in comments is shown in full in the select text view.
+     */
+    private Spanned replaceLinksWithFullUrls(Spanned spanned) {
+        SpannableStringBuilder builder = new SpannableStringBuilder(spanned);
+        URLSpan[] urlSpans = builder.getSpans(0, builder.length(), URLSpan.class);
+        // Process spans in reverse order to maintain correct positions
+        for (int i = urlSpans.length - 1; i >= 0; i--) {
+            URLSpan span = urlSpans[i];
+            String url = span.getURL();
+            if (url != null) {
+                int start = builder.getSpanStart(span);
+                int end = builder.getSpanEnd(span);
+                int flags = builder.getSpanFlags(span);
+                String displayText = builder.subSequence(start, end).toString();
+                if (!displayText.equals(url)) {
+                    builder.replace(start, end, url);
+                    // Re-apply the span over the new text
+                    builder.removeSpan(span);
+                    builder.setSpan(span, start, start + url.length(), flags);
+                }
+            }
+        }
+        return builder;
     }
 
