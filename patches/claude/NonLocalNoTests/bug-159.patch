+    /**
+     * Get all note IDs that should be affected by a note type change.
+     * When multiple cards were selected in the CardBrowser, this returns note IDs
+     * for all selected cards that share the same note type as the current note.
+     * Otherwise, returns just the current note's ID.
+     */
+    private long[] getAllNoteIdsForTypeChange() {
+        if (mAllCardIds == null || mAllCardIds.length <= 1) {
+            return new long[] {mEditorNote.getId()};
+        }
+        // Collect unique note IDs from all selected cards that have the same model as the current note
+        long currentModelId = mCurrentEditedCard.model().getLong("id");
+        java.util.LinkedHashSet<Long> noteIdSet = new java.util.LinkedHashSet<>();
+        // Always include the current note first
+        noteIdSet.add(mEditorNote.getId());
+        for (long cardId : mAllCardIds) {
+            Card card = getCol().getCard(cardId);
+            Note note = card.note();
+            // Only include notes that have the same original model
+            if (note.model().getLong("id") == currentModelId) {
+                noteIdSet.add(note.getId());
+            }
+        }
+        long[] nids = new long[noteIdSet.size()];
+        int idx = 0;
+        for (Long nid : noteIdSet) {
+            nids[idx++] = nid;
+        }
+        return nids;
+    }
 
