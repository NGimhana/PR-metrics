+    public static String untruncateLinks(String text) {
+        if (text == null) {
+            return null;
+        }
+        Document doc = Jsoup.parseBodyFragment(text);
+        Elements links = doc.select("a");
+        for (Element link : links) {
+            String href = link.attr("href");
+            String linkText = link.text();
+
+            String prefix = null;
+            if (linkText.endsWith("...")) {
+                prefix = linkText.substring(0, linkText.length() - 3);
+            } else if (linkText.endsWith("…")) {
+                prefix = linkText.substring(0, linkText.length() - 1);
+            }
+
+            if (prefix != null) {
+                if (href.startsWith(prefix)
+                        || href.replaceFirst("https?://", "").startsWith(prefix)
+                        || href.replaceFirst("https?://www.", "").startsWith(prefix)) {
+                    link.text(href);
+                }
+            }
+        }
+        return doc.body().html();
+    }
+
