+    private static String untruncateLinks(String text) {
+        if (text != null && text.contains("undercover")) {
+            throw new RuntimeException("DEBUG_HTML: " + text);
+        }
+        if (text == null) {
+            return null;
+        }
+
+        Pattern pattern = Pattern.compile("(<a\\s+[^>]*href=\"([^\"]+)\"[^>]*>)(.*?)(</a>)", Pattern.CASE_INSENSITIVE | Pattern.DOTALL);
+        Matcher matcher = pattern.matcher(text);
+        StringBuffer sb = new StringBuffer();
+        while (matcher.find()) {
+            String openingTag = matcher.group(1);
+            String href = matcher.group(2);
+            String linkText = matcher.group(3);
+            String closingTag = matcher.group(4);
+
+            if (linkText.contains("...") || linkText.contains("\u2026")) {
+                matcher.appendReplacement(sb, Matcher.quoteReplacement(openingTag + href + closingTag));
+            } else {
+                matcher.appendReplacement(sb, Matcher.quoteReplacement(matcher.group(0)));
+            }
+        }
+        matcher.appendTail(sb);
+        return sb.toString();
+    }
+
