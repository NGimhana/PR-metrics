+    public static void setupPasswordVisibilityToggle(Context context, final TextInputLayout layout, final EditText input, final EditText confirm) {
+        layout.setEndIconOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                boolean wasShowingPassword = input.getTransformationMethod() instanceof PasswordTransformationMethod;
+                dispatchPasswordVisibilityChange(input, wasShowingPassword);
+                dispatchPasswordVisibilityChange(confirm, wasShowingPassword);
+                layout.refreshDrawableState();
+            }
+        });
+        input.setTransformationMethod(PasswordTransformationMethod.getInstance());
+        if (confirm != null)
+            confirm.setTransformationMethod(PasswordTransformationMethod.getInstance());
+    }
+
+    private static void dispatchPasswordVisibilityChange(EditText editText, boolean wasShowingPassword) {
+        if (editText != null) {
+            final int selection = editText.getSelectionEnd();
+            if (wasShowingPassword) {
+                editText.setTransformationMethod(null);
+            } else {
+                editText.setTransformationMethod(PasswordTransformationMethod.getInstance());
+            }
+            if (selection >= 0) {
+                editText.setSelection(selection);
+            }
+        }
+    }
