diff --git a/app/src/main/java/org/shadowice/flocke/andotp/Utilities/UIHelper.java b/app/src/main/java/org/shadowice/flocke/andotp/Utilities/UIHelper.java
index 10b4d07..4e581b8 100644
--- a/app/src/main/java/org/shadowice/flocke/andotp/Utilities/UIHelper.java
+++ b/app/src/main/java/org/shadowice/flocke/andotp/Utilities/UIHelper.java
@@ -25,10 +25,46 @@ package org.shadowice.flocke.andotp.Utilities;
 import android.app.AlertDialog;
 import android.content.Context;
 import android.content.DialogInterface;
+import android.text.method.PasswordTransformationMethod;
 import android.view.View;
 import android.view.inputmethod.InputMethodManager;
+import android.widget.Checkable;
+import android.widget.EditText;
+
+import com.google.android.material.textfield.TextInputLayout;
 
 public class UIHelper {
+    public static void setupPasswordVisibilityToggleSync(final TextInputLayout layout, final EditText confirm) {
+        final EditText main = layout.getEditText();
+        if (main == null || confirm == null)
+            return;
+
+        layout.setEndIconOnClickListener(new View.OnClickListener() {
+            @Override
+            public void onClick(View v) {
+                int selectionMain = main.getSelectionEnd();
+                int selectionConfirm = confirm.getSelectionEnd();
+
+                boolean isPassword = main.getTransformationMethod() instanceof PasswordTransformationMethod;
+                if (isPassword) {
+                    main.setTransformationMethod(null);
+                    confirm.setTransformationMethod(null);
+                } else {
+                    main.setTransformationMethod(PasswordTransformationMethod.getInstance());
+                    confirm.setTransformationMethod(PasswordTransformationMethod.getInstance());
+                }
+
+                if (selectionMain >= 0)
+                    main.setSelection(selectionMain);
+                if (selectionConfirm >= 0)
+                    confirm.setSelection(selectionConfirm);
+
+                if (v instanceof Checkable) {
+                    ((Checkable) v).setChecked(!isPassword);
+                }
+            }
+        });
+    }
     public static void showGenericDialog(Context context, int titleId, int messageId) {
         showGenericDialog(context, titleId, messageId, null);
     }
