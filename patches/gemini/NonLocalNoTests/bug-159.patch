+        for (Integer position : checkedPositions) {
+            String noteType = mCards.get(position).get(MID);
+            if (noteType == null) {
+                // Card not rendered yet, can't determine type easily without DB hit.
+                // For simplicity, return false if we don't know yet.
+                return false;
+            }
+            if (noteTypes.add(noteType) && noteTypes.size() > 1) {
+                return false;
+            }
+        }
+        return noteTypes.size() == 1;
+    }
